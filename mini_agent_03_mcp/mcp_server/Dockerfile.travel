# Build context: mini_agent_03_mcp
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8010
WORKDIR /app

COPY mcp_server/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY mcp_server/travel_server.py ./travel_server.py
COPY mcp_server/healthcheck.py ./healthcheck.py

EXPOSE 8010
CMD ["python", "travel_server.py"]
