# Build context: mini_agent_03_mcp
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MCP_TRANSPORT=streamable-http \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8011
WORKDIR /app

COPY mcp_server/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY mcp_server/policy_stdio_server.py ./policy_stdio_server.py
COPY mcp_server/healthcheck.py ./healthcheck.py

EXPOSE 8011
CMD ["python", "policy_stdio_server.py"]
