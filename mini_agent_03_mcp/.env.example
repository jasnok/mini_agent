BACKEND_API_URL=http://127.0.0.1:8000
TRAVEL_MCP_URL=http://127.0.0.1:8010/mcp
# 비워 두면 Policy를 기존 stdio 자식 프로세스로 실행합니다.
# HTTP 서버를 별도로 실행한 경우: http://127.0.0.1:8011/mcp
# Docker Compose에서는: http://policy:8011/mcp
POLICY_MCP_URL=
# 아래 HOST/PORT는 Travel 실행 설정입니다.
# Policy HTTP 실행 시 해당 프로세스에 MCP_TRANSPORT=streamable-http,
# MCP_HOST=127.0.0.1, MCP_PORT=8011을 별도로 전달하세요.
MCP_HOST=127.0.0.1
MCP_PORT=8010
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
